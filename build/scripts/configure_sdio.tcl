# Apply after open_bd_design; preserve SDIO and one-way UART0 logging.
set bridge_ps [get_bd_cells processing_system7_0]
set_property -dict [list \
    CONFIG.PCW_SD0_PERIPHERAL_ENABLE {1} CONFIG.PCW_SD0_SD0_IO {MIO 40 .. 45} \
    CONFIG.PCW_SD0_GRP_CD_ENABLE {0} CONFIG.PCW_SD0_GRP_WP_ENABLE {0} CONFIG.PCW_SD0_GRP_POW_ENABLE {0} \
    CONFIG.PCW_SD1_PERIPHERAL_ENABLE {1} CONFIG.PCW_SD1_SD1_IO {MIO 10 .. 15} \
    CONFIG.PCW_SD1_GRP_CD_ENABLE {0} CONFIG.PCW_SD1_GRP_WP_ENABLE {0} CONFIG.PCW_SD1_GRP_POW_ENABLE {0} \
    CONFIG.PCW_UART0_PERIPHERAL_ENABLE {1} CONFIG.PCW_UART0_UART0_IO {MIO 26 .. 27} \
    CONFIG.PCW_UART0_BAUD_RATE {115200} CONFIG.PCW_UART0_GRP_FULL_ENABLE {0} \
    CONFIG.PCW_SPI1_GRP_SS1_ENABLE {0} CONFIG.PCW_SPI1_GRP_SS2_ENABLE {0}] $bridge_ps
validate_bd_design
foreach {property expected} {PCW_SD0_PERIPHERAL_ENABLE 1 PCW_SD1_PERIPHERAL_ENABLE 1 PCW_SD0_SD0_IO {MIO 40 .. 45} PCW_SD1_SD1_IO {MIO 10 .. 15} PCW_SPI1_PERIPHERAL_ENABLE 1 PCW_SPI1_GRP_SS1_ENABLE 0 PCW_SPI1_GRP_SS2_ENABLE 0 PCW_UART0_PERIPHERAL_ENABLE 1 PCW_UART0_UART0_IO {MIO 26 .. 27} PCW_UART1_PERIPHERAL_ENABLE 1 PCW_UART1_UART1_IO {MIO 16 .. 17}} {
    if {[get_property CONFIG.$property $bridge_ps] ne $expected} { error "SDIO configuration mismatch: $property" }
}
save_bd_design
unset bridge_ps
