# Vivado generated state (the .xpr and managed .srcs inputs are tracked)
/.Xil/
/.vivado-user/
/vivado/*.cache/
/vivado/*.gen/
/vivado/*.hw/
/vivado/*.ip_user_files/
/vivado/*.runs/
/vivado/*.sim/
/vivado/*.tmp/
/vivado/*.jou
/vivado/*.log
/vivado/*.str
/vivado/*.dcp
/vivado/*.bit
/vivado/*.xsa
# Block Design canvas/layout state; regenerated by the Vivado GUI.
/vivado/ultrasound_B_mode_imaging.srcs/sources_1/bd/bd/ui/

# Vitis workspace: track project definitions and application sources; regenerate
# platform exports, BSP/FSBL content, CMake state and download artifacts.
/workspace/.rigel_lopper/
/workspace/_ide/
/workspace/B_mode_focus_imaging/build/
/workspace/B_mode_focus_imaging/compile_commands.json
/workspace/B_mode_focus_imaging/src/compile_commands.json
/workspace/B_mode_focus_imaging/src/.compile_commands/
/workspace/B_mode_focus_imaging/src/.cache/
/workspace/B_mode_focus_imaging/src/.clangd
/workspace/B_mode_focus_imaging/_ide/bitstream/
/workspace/B_mode_focus_imaging/_ide/hwspec.checksum
/workspace/ubmi_p/export/
/workspace/ubmi_p/hw/
/workspace/ubmi_p/ps7_cortexa9_0/
/workspace/ubmi_p/zynq_fsbl/
vitis_journal.py
.metadata/
.settings/
Debug/
Release/

# The release ILA stub is a required source. Windows Git matches the generic
# Release/ rule case-insensitively, so explicitly keep both canonical and
# Vivado-managed copies visible to version control.
!/build/src/imports/release/
!/build/src/imports/release/**
!/vivado/ultrasound_B_mode_imaging.srcs/sources_1/imports/imports/release/
!/vivado/ultrasound_B_mode_imaging.srcs/sources_1/imports/imports/release/**

# Reproducible build state and delivery artifacts
# This directory also holds canonical source code: do not ignore /build/ itself.
/build/*
!/build/src/
!/build/scripts/
!/build/constraints/
!/build/vivado.tcl
!/build/README.md
/tools/__pycache__/
/build/scripts/__pycache__/
/build/scripts/tests/__pycache__/
